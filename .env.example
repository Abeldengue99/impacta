# Copy this file to .env in the IMPACTA project root and fill it in locally.
# Do not commit .env or send its password through chat.

APP_ENV=development
API_HOST=::1
API_PORT=3001
FRONTEND_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3001,http://127.0.0.1:3001
FRONTEND_BASE_URL=http://localhost/Impacta

# Use a dedicated PostgreSQL login role named impacta_app.
# Do not use the postgres superuser for the application.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=Impacta
PGUSER=impacta_app
PGPASSWORD=
PGSSL=false
# Optional absolute path to pg_dump when it is not available on PATH.
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
# In production set this explicitly from the database connection budget across all API instances.
PGPOOL_MAX=5
# For production TLS with a private CA, set PGSSL=true and provide its local path:
# PGSSL_CA=C:/path/to/postgresql-ca.pem

# Required in production: generate a random value of at least 32 bytes; keep it in a secret manager.
AUTH_TOKEN_PEPPER=
# Dedicated 32-byte key for encrypting administrator TOTP secrets (64 hex characters).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key backed up securely; changing it makes enrolled authenticator secrets unreadable.
MFA_ENCRYPTION_KEY=
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD and SMTP_FROM_EMAIL are required in production.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=IMPACTA

# Optional generative help assistant. Keep the API key only in the local .env.
# Choose a model enabled for the OpenAI project associated with this key.
IMPACTA_AI_API_KEY=
IMPACTA_AI_MODEL=

# Optional: absolute paths if FFmpeg is not available on PATH.
# IMPACTA_FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# IMPACTA_FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
# IMPACTA_MEDIA_DIR=C:/ImpactaData/media
# Production requires IMPACTA_MEDIA_DIR to point outside the application/public directory.
# Video conversion is limited to one concurrent job per API process by default (allowed range: 1-4).
# IMPACTA_MAX_CONCURRENT_VIDEO_PROCESSING=1
