Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.well-known/acme-challenge(?:/|$) - [L]
    RewriteRule (^|/)\. - [F,L,NC]
    RewriteRule ^(?:backend|\.git|node_modules|deploy|docs|outputs|local-recovery)(?:/|$) - [F,L,NC]
    RewriteRule \.(?:sql|ts|map|md|log|env)$ - [F,L,NC]
</IfModule>

<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

<FilesMatch "^(?:package(?:-lock)?\.json|tsconfig\.json|SECURITY-RELEASE-CHECKLIST\.md|preserved-local-.*\.html)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>
